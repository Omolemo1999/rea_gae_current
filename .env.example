# Paystack webhook is configured in the Paystack dashboard to POST to /api/payments/webhook

# CompreFace self-hosted face verification (server-side only)
# Start CompreFace with: docker compose --profile face up -d
# Then create a VERIFICATION service in http://localhost:8000 and copy its API key here.
COMPREFACE_BASE_URL=http://localhost:8000
COMPREFACE_VERIFICATION_API_KEY=
COMPREFACE_DET_PROB_THRESHOLD=0.8
COMPREFACE_SIMILARITY_THRESHOLD=0.75
